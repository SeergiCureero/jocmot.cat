# URL del backend PocketBase (comptes i progrés). Si es deixa buit,
# l'app funciona en "mode local": tot es guarda al navegador (només per desenvolupar).
VITE_POCKETBASE_URL=

# Data de llançament (puzle #1). Format AAAA-MM-DD.
VITE_LAUNCH_DATE=2026-10-14

# Token públic de Cloudflare Web Analytics (sense galetes). Buit = sense analítica.
VITE_CF_ANALYTICS_TOKEN=
